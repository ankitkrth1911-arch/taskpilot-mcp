# Backend API Base URL (leave empty for built-in demo mode)
VITE_API_BASE=http://localhost:8000

# Supabase Authentication & Client Configuration (public by design)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Cloudflare Turnstile Site Key for captcha challenge
VITE_TURNSTILE_SITE_KEY=

# Auto guest sign-in (default "false", requires Turnstile token if enabled)
VITE_AUTO_GUEST=false
