# ==============================================================================
# TaskPilot Graph Configuration
# ==============================================================================

# FalkorDB Connection (Default: localhost:6379, FalkorDB Cloud supported)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_GRAPH=taskpilot

# Admin secret token required in X-Admin-Token header for POST /api/admin/reset
ADMIN_TOKEN=

# Rate Limiting
RATE_LIMIT_PER_MIN=10
DAILY_AGENT_CAP=500

# Optional: Google Gemini API Key for LLM tool calling mode
# If left empty, TaskPilot Graph runs in deterministic graph-driven agent mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Supabase Authentication and Database Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Razorpay TEST Billing Configuration
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# CORS Allowed Origins (comma-separated allowlist)
ALLOWED_ORIGIN=http://localhost:5173,http://localhost:3000
