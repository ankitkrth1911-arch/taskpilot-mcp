# ==============================================================================
# TaskPilot Graph Configuration
# ==============================================================================

# FalkorDB Connection (Default: localhost:6379, FalkorDB Cloud supported)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_GRAPH=taskpilot

# Admin secret token required in X-Admin-Token header for POST /api/admin/reset
ADMIN_TOKEN=

# Rate Limiting
RATE_LIMIT_PER_MIN=10
DAILY_AGENT_CAP=500

# Optional: Google Gemini API Key for LLM tool calling mode
# If left empty, TaskPilot Graph runs in deterministic graph-driven agent mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
